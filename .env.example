# Global leaderboard (pfaustino/leaderboards API)
# Copy to `.env` and fill in for local dev. Never commit `.env`.
#
# API base — the shared leaderboard server. Defaults to the production host
# if unset (see game_v3.js LEADERBOARD.apiBase).
VITE_LEADERBOARD_API=https://leaderboards-opal.vercel.app

# Per-game write key (must match the bullet-hell key in the server's
# WRITE_KEYS Vercel env). Visible in the client bundle — deters casual
# spam only. Leave empty to run the leaderboard read-only/offline.
#
# Auto-setup: run `powershell -ExecutionPolicy Bypass -File scripts\setup-leaderboard-key.ps1`
# (generates a key, prints the Vercel WRITE_KEYS JSON to paste, writes .env).
# Verify afterwards with `npm run verify:leaderboard`.
VITE_LEADERBOARD_WRITE_KEY=